<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector"      Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk"  Version="17.8.0" />
    <PackageReference Include="xunit"                   Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <!-- Serilog sink used in WithSerilog tests -->
    <PackageReference Include="Serilog.Sinks.Console"   Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Primitives.Observability\Primitives.Observability.csproj" />
    <ProjectReference Include="..\..\src\Primitives.Observability.Serilog\Primitives.Observability.Serilog.csproj" />
    <ProjectReference Include="..\..\src\Primitives.Observability.Log4Net\Primitives.Observability.Log4Net.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- log4net config used by WithLog4Net tests -->
    <Content Include="log4net.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
